# ATLAS configuration. Copy to .env and fill in. Never commit real secrets.
NODE_ENV=development
# Empty DATABASE_URL uses embedded PGlite (PostgreSQL in WASM) stored in ./data/pglite
DATABASE_URL=
# Hosted Supabase (project-atlas, ref wyknwjdcexisrempmvjr, https://wyknwjdcexisrempmvjr.supabase.co):
# Dashboard → project-atlas → Connect → "Session pooler" URI
# (user postgres.wyknwjdcexisrempmvjr, port 5432, database postgres; copy the pooler host exactly as shown,
# e.g. aws-<n>-ap-south-1.pooler.supabase.com). Set DATABASE_SSL=require (dev) or verify-full + DATABASE_CA_CERT.
# Put it in .env.local only (git-ignored). The browser never talks to Supabase and ATLAS uses its own
# authentication (ADR-012/013), so no NEXT_PUBLIC_SUPABASE_* URL or publishable key is needed.
# TLS for DATABASE_URL: require (dev) | verify-full (production; needs DATABASE_CA_CERT) | disable
DATABASE_SSL=
DATABASE_CA_CERT=
PGLITE_DIR=./data/pglite
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
# 32+ byte random secret used to sign CSRF tokens and export links
APP_SECRET=change-me-dev-only-secret-change-me-dev-only
# Object storage: local filesystem in dev; S3 adapter in production
OBJECT_STORE_DIR=./data/objects
# Email: "outbox" stores mails in the database (dev mail viewer at /admin/outbox); "smtp" delivers through SMTP_URL (smtp[s]://user:password@host:port) and needs EMAIL_FROM
EMAIL_TRANSPORT=outbox
SMTP_URL=
EMAIL_FROM=
# AI provider: "deterministic" (template composer, no external calls) or "anthropic"
AI_PROVIDER=deterministic
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_COST_BUDGET_INR_PER_ANSWER=5
# Payments: "sandbox" uses the built-in gateway simulator; "razorpay" requires keys below
PAYMENT_GATEWAY=sandbox
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# JSON maps to ids created in the Razorpay dashboard: plan -> plan id, coupon code -> offer id (a coupon without an offer is refused)
RAZORPAY_PLAN_IDS=
RAZORPAY_OFFER_IDS=
SANDBOX_WEBHOOK_SECRET=sandbox-webhook-secret-dev-only
# GST
GST_RATE=0.18
SUPPLIER_STATE_CODE=29
SUPPLIER_GSTIN=
# Google sign-in (blocked until OAuth client exists)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# ATLAS Digital Assets (free public sources; see docs/crypto/SOURCE_CAPABILITY_MATRIX.md)
# Optional free CoinGecko Demo key (raises the rate limit). Leave empty to use the keyless public API.
COINGECKO_DEMO_API_KEY=
# COINGECKO_API_KEY is accepted as an alias of COINGECKO_DEMO_API_KEY.
# Scheduled crypto ingestion and the Binance WebSocket feed (default on outside tests)
CRYPTO_INGESTION=
CRYPTO_LIVE_FEED=
CRYPTO_LIVE_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,XRPUSDT,BNBUSDT,DOGEUSDT,ADAUSDT,LINKUSDT
CRYPTO_UNIVERSE_SIZE=100
CRYPTO_HISTORY_ASSETS=25
CRYPTO_BACKFILL_REQUESTS_PER_RUN=30
ETHEREUM_RPC_URL=https://ethereum-rpc.publicnode.com
# Indian equity reference data: your own keys (free personal plans). Leave empty if you have none.
# Put real values only in .env.local (git-ignored). EODHD_API_KEY is accepted as an alias.
EODHD_API_TOKEN=
ALPHAVANTAGE_API_KEY=
# Your EODHD plan's daily API-call allowance (free plan: 20) and its split by purpose; empty = defaults
# (refresh=12,backfill=2,validation=2,manual=2,reserve=2). Budgets must add up to the limit.
EODHD_DAILY_LIMIT=
EODHD_QUOTA_BUDGETS=
# Scheduled refresh of the tracked universe at 08:00 and 20:30 IST (empty = on outside tests).
EQUITY_REFRESH=
# Demo mode: fictional development companies in Companies, Market, Screener, Lab, Assistant (empty = on
# outside production; production refuses it). false = real-data mode for customers (demo sections hidden).
ALLOW_SYNTHETIC_DATA=
# Macro and commodities. FRED_API_KEY: official FRED API (vintages; without it commodities use the public CSV).
FRED_API_KEY=
# EIA (US crude and gas inventories; historical WTI futures by contract position): free key from eia.gov/opendata.
EIA_API_KEY=
# data.gov.in Open Government Data API key (Indian mandi prices): free registration at data.gov.in.
DATA_GOV_IN_API_KEY=
# Scheduled commodity refresh (empty = on outside tests).
COMMODITY_REFRESH=
# Annual risk-free rate for Sharpe/Sortino (decimal). Empty = 0, shown as such next to each ratio.
RESEARCH_RISK_FREE_RATE=
