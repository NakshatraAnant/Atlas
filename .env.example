# ATLAS configuration. Copy to .env and fill in. Never commit real secrets.
NODE_ENV=development
# Empty DATABASE_URL uses embedded PGlite (PostgreSQL in WASM) stored in ./data/pglite
DATABASE_URL=
# Hosted Supabase (project-atlas, ref wyknwjdcexisrempmvjr, https://wyknwjdcexisrempmvjr.supabase.co):
# Dashboard → project-atlas → Connect → "Session pooler" URI
# (user postgres.wyknwjdcexisrempmvjr, port 5432, database postgres; copy the pooler host exactly as shown,
# e.g. aws-<n>-ap-south-1.pooler.supabase.com). Set DATABASE_SSL=require (dev) or verify-full + DATABASE_CA_CERT.
# Put it in .env.local only (git-ignored). The browser never talks to Supabase and ATLAS uses its own
# authentication (ADR-012/013), so no NEXT_PUBLIC_SUPABASE_* URL or publishable key is needed.
# TLS for DATABASE_URL: require (dev) | verify-full (production; needs DATABASE_CA_CERT) | disable
DATABASE_SSL=
DATABASE_CA_CERT=
PGLITE_DIR=./data/pglite
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
# 32+ byte random secret used to sign CSRF tokens and export links
APP_SECRET=change-me-dev-only-secret-change-me-dev-only
# Object storage: local filesystem in dev; S3 adapter in production
OBJECT_STORE_DIR=./data/objects
# Email: "outbox" stores mails in the database (dev mail viewer at /admin/outbox); "ses" requires AWS credentials
EMAIL_TRANSPORT=outbox
# AI provider: "deterministic" (template composer, no external calls) or "anthropic"
AI_PROVIDER=deterministic
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_COST_BUDGET_INR_PER_ANSWER=5
# Payments: "sandbox" uses the built-in gateway simulator; "razorpay" requires keys below
PAYMENT_GATEWAY=sandbox
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
SANDBOX_WEBHOOK_SECRET=sandbox-webhook-secret-dev-only
# GST
GST_RATE=0.18
SUPPLIER_STATE_CODE=29
SUPPLIER_GSTIN=
# Google sign-in (blocked until OAuth client exists)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# ATLAS Digital Assets (free public sources; see docs/crypto/SOURCE_CAPABILITY_MATRIX.md)
# Optional free CoinGecko Demo key (raises the rate limit). Leave empty to use the keyless public API.
COINGECKO_DEMO_API_KEY=
# Scheduled crypto ingestion and the Binance WebSocket feed (default on outside tests)
CRYPTO_INGESTION=
CRYPTO_LIVE_FEED=
CRYPTO_LIVE_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,XRPUSDT,BNBUSDT,DOGEUSDT,ADAUSDT,LINKUSDT
CRYPTO_UNIVERSE_SIZE=100
CRYPTO_HISTORY_ASSETS=25
CRYPTO_BACKFILL_REQUESTS_PER_RUN=30
ETHEREUM_RPC_URL=https://ethereum-rpc.publicnode.com
