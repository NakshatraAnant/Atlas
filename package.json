{
  "name": "atlas",
  "private": true,
  "version": "0.1.0",
  "description": "ATLAS — research workspace for Indian equities (Release 1.0 MVP)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build -w @atlas/shared && npm run typecheck -w @atlas/api && npm run build -w @atlas/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test -w @atlas/shared && npm run test -w @atlas/api && npm run test -w @atlas/web",
    "test:web": "npm run test -w @atlas/web",
    "seed": "npm run seed -w @atlas/api",
    "dev:api": "npm run dev -w @atlas/api",
    "dev:web": "npm run dev -w @atlas/web",
    "eval": "npm run eval -w @atlas/api",
    "check:secrets": "node scripts/check-secrets.mjs",
    "test:postgres": "node scripts/test-postgres.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "video:render": "tsx scripts/video/render.mts",
    "video:verify": "tsx scripts/video/verify.mts",
    "test:all": "npm test && npm run test:postgres"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "2.1.9",
    "webm-muxer": "5.1.4"
  },
  "overrides": {
    "postcss": "8.5.28"
  }
}
